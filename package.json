{
  "name": "tastytrade-mcp-server",
  "version": "1.0.0",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "tastytrade-mcp-server": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc && node build/index.js",
    "dev:http": "tsc && MCP_TRANSPORT=http node build/index.js",
    "test:hooks": "python hooks/tests/run_tests.py",
    "test:renderers": "tsc && node --test build/tests/render-utils.test.js",
    "test:token-store": "tsc && node --test build/tests/token-store.test.js",
    "test:smoke:futures": "tsc && node build/tests/smoke-futures-quotes.js",
    "test:smoke:auth-persistence": "tsc && node build/tests/smoke-auth-persistence.js",
    "check:skill-drift": "node scripts/check-skill-drift.js",
    "skills:map": "homingo map --skills-dir ./skills --no-open",
    "skills:scan": "homingo scan --skills-dir ./skills --no-open",
    "skills:lint": "homingo lint --skills-dir ./skills --dry-run --no-open"
  },
  "keywords": [
    "mcp",
    "tastytrade",
    "trading",
    "market-data"
  ],
  "author": "",
  "license": "MIT",
  "description": "MCP server for TastyTrade brokerage API integration",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@tastytrade/api": "^7.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "@types/ws": "^8.18.1",
    "express": "^5.2.1",
    "typescript": "^5.9.3",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "homingo": "^0.15.1"
  }
}
